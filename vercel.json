{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/(movie|series|person)/[^/]+/?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(GPTBot|ElevenlabsCrawler).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
